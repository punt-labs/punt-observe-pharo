#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
image_dir=${IMAGE_DIR:-$root/pharo}
port=${PORT:-8430}
case "$port" in ''|*[!0-9]*) echo 'Invalid PORT' >&2; exit 1 ;; esac
mkdir -p "$root/.tmp"
pidfile="$root/.tmp/pharo-$port.pid"
logfile="$root/.tmp/pharo-$port.log"
case "${1:-}" in
start)
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        curl -fsS "http://localhost:$port/health"
        exit 0
    fi
    if curl -fsS "http://localhost:$port/health" >/dev/null 2>&1; then
        echo "Port $port is already serving an unmanaged image" >&2
        exit 1
    fi
    test -f "$image_dir/.setup-complete" || { echo 'Run make setup first' >&2; exit 1; }
    nohup "$image_dir/pharo" "$image_dir/Pharo.image" eval --no-quit \
        "PosternServer startOn: $port" >"$logfile" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$pidfile"
    attempts=0
    while [ "$attempts" -lt 60 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then cat "$logfile"; exit 1; fi
        if curl -fsS "http://localhost:$port/health" >/dev/null 2>&1; then
            printf 'Postern ready on %s (PID %s)\n' "$port" "$pid"
            exit 0
        fi
        attempts=$((attempts + 1))
        sleep 1
    done
    kill "$pid"
    echo 'Image startup timed out' >&2
    exit 1
    ;;
stop)
    if [ -f "$pidfile" ]; then
        pid=$(cat "$pidfile")
        kill "$pid" 2>/dev/null || true
        rm -f "$pidfile"
    fi
    ;;
*) echo 'usage: runtime start|stop' >&2; exit 1 ;;
esac
